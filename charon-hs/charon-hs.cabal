cabal-version:      2.4
name:               charon-hs
version:            0.1.0.0
synopsis:           Haskell bindings for Charon LLBC
description:        Auto-generated Haskell types and Aeson FromJSON instances for Charon's LLBC AST
license:            Apache-2.0
author:             Charon Team
maintainer:         charon@example.com
category:           Development
build-type:         Simple

common shared-properties
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

library
  import:           shared-properties
  hs-source-dirs:   src/generated
  exposed-modules:
    Generated_Meta
    Generated_Values
    Generated_Types
    Generated_Expressions
    Generated_GAst
    Generated_LlbcAst
    Generated_UllbcAst
    Generated_GAstOfJson
    Generated_LlbcOfJson
    Generated_UllbcOfJson
  build-depends:
    base >= 4.14 && < 5,
    aeson >= 2.0,
    text >= 1.2,
    unordered-containers >= 0.2

test-suite charon-hs-test
  import:           shared-properties
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    Test.Deserialize
  build-depends:
    base >= 4.14 && < 5,
    charon-hs,
    aeson >= 2.0,
    text >= 1.2,
    bytestring >= 0.10,
    directory >= 1.3,
    filepath >= 1.4,
    tasty >= 1.4,
    tasty-hunit >= 0.10
